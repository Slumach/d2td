{
  "name": "d2td",
  "private": true,
  "version": "0.0.0",
  "description": "Non-commercial Diablo II fan tower defense. Bring your own D2R install.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tools",
    "extract": "tsx tools/extract/index.ts",
    "balance": "tsx tools/balance.ts",
    "ladders": "tsx tools/ladders.ts"
  },
  "dependencies": {
    "@jamiephan/casclib": "0.3.0",
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "electron": "43.7.7",
    "electron-builder": "26.17.0",
    "tsx": "4.20.3",
    "typescript": "5.8.3",
    "vite": "6.4.4",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "@jamiephan/casclib@0.3.0": true
  }
}
