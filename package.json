{
  "name": "d2td",
  "productName": "D2 Tower Defense",
  "private": true,
  "version": "0.2.2",
  "description": "Non-commercial Diablo II fan tower defense. Bring your own D2R install.",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tools && tsc --noEmit -p electron",
    "extract": "tsx tools/extract/index.ts",
    "items": "tsx tools/items-check.ts",
    "drops": "tsx tools/drops.ts",
    "cow": "tsx tools/cow.ts",
    "loot": "tsx tools/loot.ts",
    "dps": "tsx tools/dpsreport.ts",
    "balance": "tsx tools/balance.ts",
    "ladders": "tsx tools/ladders.ts",
    "build:app": "tsc --noEmit && tsc --noEmit -p electron && vite build && vite build -c vite.electron.config.ts",
    "app": "npm run build:app && electron .",
    "dist": "npm run build:app && electron-builder --win nsis --publish never && tsx tools/payload-check.ts",
    "publish": "npm run dist && tsx tools/publish.ts",
    "payload-check": "tsx tools/payload-check.ts",
    "mp-soak": "tsx tools/mp-soak.ts",
    "waves": "tsx tools/waves.ts",
    "report": "tsx tools/report.ts"
  },
  "dependencies": {
    "@jamiephan/casclib": "0.3.0",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "electron": "43.7.7",
    "electron-builder": "26.17.0",
    "phaser": "3.90.0",
    "tsx": "4.20.3",
    "typescript": "5.8.3",
    "vite": "6.4.4",
    "vitest": "5.0.5"
  },
  "build": {
    "appId": "local.d2td.towerdefense",
    "productName": "D2 Tower Defense",
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "generic",
      "url": "https://d2td-updates.s3.amazonaws.com"
    },
    "releaseInfo": {
      "releaseNotesFile": "release-notes.md"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@jamiephan/casclib/**"
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "@jamiephan/casclib@0.3.0": true,
    "electron-winstaller@5.4.0": false
  }
}
